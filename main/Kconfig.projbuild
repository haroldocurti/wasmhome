menu "WasmHome common platform"
config WASMHOME_WIFI_SSID
    string "Wi-Fi SSID"
    default "Hal9000"
config WASMHOME_WIFI_PASSWORD
    string "Wi-Fi password (local sdkconfig only)"
    default ""
config WASMHOME_OBSERVER_IPV4
    string "Observer IPv4 address (empty disables UDP)"
    default ""
config WASMHOME_UDP_PORT
    int "UDP observation port (device and observer)"
    range 1024 65535
    default 3333
config WASMHOME_SENSOR_GPIO
    int
    default 4
config WASMHOME_CONTROL_GPIO
    int
    default 5
config WASMHOME_LOOPBACK_GPIO
    int
    default 6
config WASMHOME_PLATFORM_SELFTEST
    bool "Run platform hardware diagnostics (not a functional service)"
    default n
    help
        Publishes diagnostic sensor telemetry and alternates the loopback output.
        Use only on the documented bench; it is not campaign service evidence.
config WASMHOME_LXC_PROBE_IPV4
    string "Temporary LXC transport fixture IPv4 (local sdkconfig only)"
    default ""
    depends on WASMHOME_PLATFORM_SELFTEST
    help
        WH_LXC tests only this IPv4, TCP port 18080 and the fixed diagnostic path.
        Empty disables the probe. The fixture proves HTTP transport only.
config WASMHOME_OBSERVER_SELFTEST
    bool "Run external observer calibration fixture (no OTA or modules)"
    default n
    depends on !WASMHOME_PLATFORM_SELFTEST
    help
        Native-only bench fixture. Replies to control probes using real GPIO
        loopback and publishes sensor telemetry. WH_GAP pauses both channels
        for one second; WH_REBOOT resets the board. Updates are rejected.
        WH_V1 and WH_V2 select the fixture rule without an artifact update.
        This firmware is only for calibrating the external observer.
config WASMHOME_RUN_BENCHMARK
    bool "Run preliminary benchmark after platform startup"
    default n
    depends on !WASMHOME_PLATFORM_SELFTEST && !WASMHOME_OBSERVER_SELFTEST
    help
        Benchmark CSV is diagnostic and does not establish service availability.
config WASMHOME_NATIVE_SERVICES
    bool "Run native DS18B20 telemetry and GPIO control services"
    default n
    depends on !WASMHOME_PLATFORM_SELFTEST && !WASMHOME_OBSERVER_SELFTEST && !WASMHOME_RUN_BENCHMARK
    help
        Installs the real native telemetry and versioned hysteresis control
        services over UDP v1. This option is native-scenario only and is
        mutually exclusive with diagnostics and benchmark firmware.
config WASMHOME_CONTROL_VERSION
    int "Native control policy version fixed in this build"
    range 1 2
    default 1
    depends on WASMHOME_NATIVE_SERVICES
    help
        Version 1 uses the 25 C threshold; version 2 uses the 30 C threshold.
        The selected value is compiled into firmware and cannot be changed at
        runtime.
endmenu
