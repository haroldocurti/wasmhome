+static void
+put_imm16_to_addr(int16 imm16, int16 *addr)
+{
+    uintptr_t address = (uintptr_t)(void *)addr;
+    uintptr_t aligned1 = address & ~(uintptr_t)3;
+    unsigned lane = (unsigned)(address & 3);
+    uint32 *word1 = (uint32 *)(void *)aligned1;
+    uint32 value1 = *word1;
+    uint16 bits = (uint16)imm16;
+
+    if (lane != 3) {
+        unsigned shift = (is_little_endian() ? lane : 2 - lane) * 8;
+        uint32 mask = UINT32_C(0xffff) << shift;
+
+        *word1 = (value1 & ~mask) | ((uint32)bits << shift);
+    }
+    else {
+        uintptr_t aligned2 = (address + 3) & ~(uintptr_t)3;
+        uint32 *word2 = (uint32 *)(void *)aligned2;
+        uint32 value2 = *word2;
+
+        if (is_little_endian()) {
+            value1 = (value1 & UINT32_C(0x00ffffff))
