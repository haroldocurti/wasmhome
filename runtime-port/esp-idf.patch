+                    "${LIB_COAP_DIR}/er-coap"
+                    "${LIB_COAP_DIR}/extension"
+                    "${IWASM_INTERP_DIR}")
+
+  if (CONFIG_WAMR_ENABLE_APP_FRAMEWORK)
+      list (APPEND include_dirs "${APP_MGR_SHARED_DIR}"
+                                "${__APP_MGR_DIR}"
+                                "${NATIVE_INTERFACE_DIR}"
+                                "${WASM_APP_LIBS_DIR}")
+  endif ()
 endif ()
 
 idf_component_register(SRCS ${srcs}
