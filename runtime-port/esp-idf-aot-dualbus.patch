new file mode 100644
index 0000000..31ecf70
--- /dev/null
+++ w/core/shared/platform/esp-idf/espidf_dualbus.h
@@ -0,0 +1,133 @@
+/*
+ * Copyright (C) 2026 WasmHome contributors.
+ * SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+ */
+
+#ifndef WASMHOME_ESP_IDF_DUALBUS_H
+#define WASMHOME_ESP_IDF_DUALBUS_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <limits.h>
+
+typedef struct {
+    uintptr_t ibus_start;
+    uintptr_t dbus_start;
+    size_t size;
+} wh_dualbus_sync_range_t;
+
+typedef int (*wh_dualbus_msync_fn)(void *addr, size_t size, int flags,
+                                   void *context);
+
+static inline bool
+wh_dualbus_is_power_of_two(size_t value)
+{
+    return value && ((value & (value - 1)) == 0);
+}
+
+static inline bool
+wh_dualbus_round_up(size_t value, size_t alignment, size_t *out)
+{
+    if (!out || !wh_dualbus_is_power_of_two(alignment)
+        || value > SIZE_MAX - (alignment - 1)) {
+        return false;
+    }
+
+    *out = (value + alignment - 1) & ~(alignment - 1);
+    return true;
+}
+
+static inline bool
+wh_dualbus_allocation_size(size_t requested, size_t alignment,
+                           size_t *data_size, size_t *allocation_size)
+{
+    size_t rounded;
+
+    if (!data_size || !allocation_size || requested == 0
+        || alignment < sizeof(uintptr_t)
+        || (alignment % sizeof(uintptr_t)) != 0
+        || !wh_dualbus_round_up(requested, alignment, &rounded)
+        || rounded > SIZE_MAX - alignment) {
+        return false;
+    }
+
+    *data_size = rounded;
+    /* One full aligned line precedes the returned data pointer. The word
+     * before that pointer stores the original allocation for os_free(). */
+    *allocation_size = rounded + alignment;
+    return true;
+}
+
+static inline bool
+wh_dualbus_sync_range(uintptr_t ibus_addr, size_t len,
+                      uintptr_t ibus_low, uintptr_t ibus_high,
+                      uintptr_t dbus_low, uintptr_t dbus_high,
+                      size_t alignment, wh_dualbus_sync_range_t *out)
+{
+    uintptr_t requested_end, aligned_end, offset, dbus_end;
+    uintptr_t mask;
+
+    if (!out || !len || !wh_dualbus_is_power_of_two(alignment)
+        || ibus_addr < ibus_low || ibus_addr >= ibus_high
+        || len > UINTPTR_MAX - ibus_addr) {
+        return false;
+    }
+
+    requested_end = ibus_addr + len;
+    if (requested_end > ibus_high
+        || requested_end > UINTPTR_MAX - (alignment - 1)) {
+        return false;
+    }
+
+    mask = (uintptr_t)alignment - 1;
+    out->ibus_start = ibus_addr & ~mask;
+    aligned_end = (requested_end + mask) & ~mask;
+    if (out->ibus_start < ibus_low || aligned_end > ibus_high
+        || aligned_end <= out->ibus_start || ibus_low < dbus_low) {
+        return false;
+    }
+
+    offset = ibus_low - dbus_low;
+    if (out->ibus_start < offset || aligned_end < offset) {
+        return false;
+    }
+    out->dbus_start = out->ibus_start - offset;
+    dbus_end = aligned_end - offset;
+    if (out->dbus_start < dbus_low || dbus_end > dbus_high
+        || dbus_end <= out->dbus_start) {
+        return false;
+    }
+
+    out->size = (size_t)(aligned_end - out->ibus_start);
+    return out->size != 0;
+}
+
+static inline int
+wh_dualbus_sync_exec(uintptr_t ibus_addr, size_t len,
+                     uintptr_t ibus_low, uintptr_t ibus_high,
+                     uintptr_t dbus_low, uintptr_t dbus_high,
+                     size_t alignment, int success_code,
+                     int data_writeback_flags, int instruction_invalidate_flags,
+                     wh_dualbus_msync_fn msync, void *context)
+{
+    wh_dualbus_sync_range_t range;
+    int result;
+
+    if (!msync
+        || !wh_dualbus_sync_range(ibus_addr, len, ibus_low, ibus_high,
+                                  dbus_low, dbus_high, alignment, &range)) {
+        return -1;
+    }
+
+    result = msync((void *)range.dbus_start, range.size,
+                   data_writeback_flags, context);
+    if (result != success_code) {
+        return result;
+    }
+
+    return msync((void *)range.ibus_start, range.size,
+                 instruction_invalidate_flags, context);
+}
+
+#endif /* WASMHOME_ESP_IDF_DUALBUS_H */
